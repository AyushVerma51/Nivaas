# ---------------------------------------------------------------
# Real Estate Platform — environment variables
# Copy to .env (root) and/or per-app .env files as needed.
# ---------------------------------------------------------------

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/real_estate

# --- API (apps/api) ---
PORT=4000
# 256-bit secret for JWT signing — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# CORS origin for the web app
CORS_ORIGIN=http://localhost:3000


# --- ML service URL (called by the price-prediction module) ---
ML_SERVICE_URL=http://localhost:8000

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Maps (Mapbox — used in Phase 2) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Redis (caching for amenities / city guide — used in Phase 3) ---
REDIS_URL=redis://localhost:6379

# --- Atlas India (tour & travel backend, apps/api — own Prisma database) ---
# PostgreSQL connection for the atlas schema (separate from real_estate above).
ATLAS_DATABASE_URL=postgres://postgres:postgres@localhost:5433/atlas
# 256-bit secrets for Atlas JWT signing — generate with: openssl rand -hex 32
ATLAS_JWT_SECRET=change-me-atlas-access-secret
ATLAS_REFRESH_SECRET=change-me-atlas-refresh-secret
# Optional: point the Atlas frontend at a deployed API (defaults to localhost:4000)
NEXT_PUBLIC_ATLAS_API=http://localhost:4000/api/v1
